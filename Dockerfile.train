# Training image: runs the full pipeline (train.py) and writes
# models/*.joblib + reports/ artifacts to the mounted volumes (see
# docker-compose.yml). The dataset is committed to the repo (see
# data/README.md), so it's simply baked in via COPY -- no volume needed
# for input data.
FROM python:3.12-slim
WORKDIR /app

COPY pyproject.toml ./
COPY src/ src/
RUN pip install --no-cache-dir .

COPY data/ data/

CMD ["python", "-m", "diabetes_prediction.train"]
